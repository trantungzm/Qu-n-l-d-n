// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model Project {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  archivedAt  DateTime?
  tasks       Task[]
  columns     Column[]
}

model Column {
  id           String   @id @default(uuid())
  name         String
  color        String   @default("gray")
  order        Int      @default(0)
  isDoneColumn Boolean  @default(false)
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]
  createdAt    DateTime @default(now())

  @@index([projectId, order])
}

model Task {
  id         String    @id @default(uuid())
  title      String
  /// @deprecated No longer read for business logic (dashboard, progress, reminders all use Column.isDoneColumn). Kept for backward-compat API fields only; candidate for removal in a future cleanup ticket.
  status     String    @default("todo")
  priority   String    @default("medium")
  type       String    @default("feature")
  order      Int       @default(0)
  dueDate    DateTime?
  columnId   String?
  column     Column?   @relation(fields: [columnId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  archivedAt DateTime?
  subTasks   SubTask[]
}

model SubTask {
  id        String   @id @default(uuid())
  title     String
  done      Boolean  @default(false)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
